name: chain-teamcity-auth-bypass
description: >
  Exploit chain: TeamCity guest access → build config enumeration → VCS credential harvest.
  TeamCity with guest access enabled exposes build configurations, agents,
  and VCS root credentials.
tags: [chain, postexploit, teamcity, credential-harvest, authorized]
weight: 80

services:
  teamcity:
    image: jetbrains/teamcity-server:2023.05
    ports: ["9423:8111"]
    environment:
      - TEAMCITY_SERVER_MEM_OPTS=-Xmx512m

ready:
  cmd: "curl -sf http://localhost:9423/app/rest/server 2>/dev/null | grep -qE 'version|buildDate'"
  timeout: 180s
  interval: 10s

assertions:
  - name: teamcity-api-accessible
    type: command
    expect:
      command: "curl -sf http://localhost:9423/app/rest/server | grep -q version"
      exit_code: 0

  - name: chain-detects-teamcity
    type: beacon
    target: "localhost:9423"
    args: ["--no-enrich", "--no-nmap", "--scanners", "portscan", "--authorized", "--deep", "--permission-confirmed", "--ports", "9423"]
    expect:
      check_id: exposure.cicd_panel

timeout: 15m
