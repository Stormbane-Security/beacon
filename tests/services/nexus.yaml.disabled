name: nexus-exposed
description: "Sonatype Nexus Repository Manager with default admin:admin123 credentials"
tags: [nexus, artifact-registry, cicd]

services:
  nexus:
    image: sonatype/nexus3:latest
    ports: ["8081:8081"]

ready:
  cmd: "curl -sf http://localhost:8081/service/rest/v1/status | grep -q true"
  timeout: 120s
  interval: 5s

assertions:
  - name: exploit-nexus-status-api
    type: command
    expect:
      command: "curl -sf http://localhost:8081/service/rest/v1/status | grep -q true"
      exit_code: 0

  - name: exploit-nexus-repositories
    type: command
    expect:
      command: "curl -sf http://localhost:8081/service/rest/v1/repositories | grep -qE '(name|format)'"
      exit_code: 0

  - name: classifies-as-nexus
    type: classify
    target: localhost:8081
    expect:
      backend_service: Sonatype Nexus

  - name: detects-nexus-exposed
    type: beacon
    target: localhost:8081
    args: ["--no-enrich", "--no-nmap", "--scanners", "portscan", "--ports", "8081"]
    expect:
      check_id: port.nexus_exposed

timeout: 10m
